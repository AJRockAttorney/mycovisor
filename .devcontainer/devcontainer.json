{
    "name": "mycovisor",
    "build": {
        "dockerfile": "Dockerfile"
    },

    // adb + the openocd/gdb TCP forward it sets up both live on the host
    // (host `adb forward tcp:3333 tcp:3333`). Host networking means
    // "localhost:3333" inside the container is the same port on the host,
    // so gdb can reach it without any USB passthrough into the container.
    "runArgs": ["--network=host"],

    // runs on the HOST (not in the container) every time the container is
    // created or started, so the adb forward + on-device openocd are up
    // before you ever need to flash/debug. `|| true` so a not-yet-connected
    // board doesn't block the container from starting.
    "initializeCommand": "cd firmware && just ensure-forwards ensure-server || true",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cmake-tools",
                "llvm-vs-code-extensions.vscode-clangd",
                "marus25.cortex-debug",
                "Catppuccin.catppuccin-vsc"
            ],
            "settings": {
                "cmake.sourceDirectory": "${workspaceFolder}/firmware",
                "cmake.configureOnOpen": true,
                "cmake.generator": "Ninja",
                "editor.inlayHints.enabled": "on",
                "workbench.colorTheme": "Catppuccin Mocha",
                // in case ms-vscode.cpptools ever ends up installed too, don't
                // let it fight clangd for squiggles/hover/go-to-def
                "C_Cpp.intelliSenseEngine": "disabled"
            }
        }
    },

    // configure with the Debug preset so firmware/build/Debug/compile_commands.json
    // exists for clangd as soon as the container is ready
    "postCreateCommand": "cd firmware && cmake --preset Debug"
}
