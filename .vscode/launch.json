{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (remote)",
            "cwd": "${workspaceFolder}/firmware",
            "executable": "${workspaceFolder}/firmware/build/Debug/mycovisor.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": "localhost:3333",
            "gdbPath": "arm-none-eabi-gdb",
            "device": "STM32U585xx",
            "runToEntryPoint": "main",
            "preLaunchTask": "build",
            "preLaunchCommands": [
                "monitor reset halt"
            ],
            "postLaunchCommands": [
                "monitor reset halt"
            ]
        }
    ]
}
